# Optional: read tiles from somewhere other than public/data/gta.pmtiles.
# VITE_PMTILES_URL=/data/downtown.pmtiles

# Safe in the browser. Row level security makes these read-only for visitors.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Secrets, used only by npm run data:events. Never prefix these with VITE_, which would expose them.
TICKETMASTER_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
